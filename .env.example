# Copiar a .env (nunca commitear .env). Auth: DefaultAzureCredential / Managed Identity, sin keys.

# live = Microsoft Foundry real · mock = sin Azure (desarrollo) · replay = reproduce una sesión grabada
DEMO_MODE=mock

# --- Microsoft Foundry -------------------------------------------------------------
# Endpoint del PROYECTO: https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_PROJECT_ENDPOINT=
# Nombres de los deployments de modelo en tu proyecto (uno por agente)
MODEL_ARQUITECTO=gpt-5.4
MODEL_FINANCIERO=gpt-5.4-mini
MODEL_RIESGO=gpt-5.4-mini
MODEL_REDACTOR=gpt-5.4-mini
# none | low | medium | high (bajo = más rápido; el enjambre tiene < 120 s)
REASONING_EFFORT=low

# --- Presupuestos del enjambre -----------------------------------------------------
SWARM_TIMEOUT_S=110
DISPLAY_BUDGET_S=120
TURN_IDLE_TIMEOUT_S=25
SWARM_MAX_ROUNDS=9
MAX_DEBATE_ROUNDS=2
# El Financiero objeta si un modelo premium concentra >= este % del costo, o si se pasa del presupuesto
OBJECTION_COMPONENT_SHARE=0.40
OBJECTION_MONTHLY_BUDGET_USD=6000

# --- Mock / replay ------------------------------------------------------------------
MOCK_SPEED=1.0
# Vacío = la sesión curada más reciente en recordings/curated/
REPLAY_FILE=

# --- Frontend (Vite) ---------------------------------------------------------------
# VITE_BRAND_LOGO_URL=/logo-readymind.svg
