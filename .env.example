# Copiar a .env (nunca commitear .env). Auth: DefaultAzureCredential / Managed Identity, sin keys.

# live = Microsoft Foundry real · mock = sin Azure (desarrollo) · replay = reproduce una sesión grabada
DEMO_MODE=mock

# --- Microsoft Foundry -------------------------------------------------------------
# Endpoint del PROYECTO: https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
FOUNDRY_PROJECT_ENDPOINT=
# Nombres de los deployments de modelo en tu proyecto (uno por agente)
MODEL_ARQUITECTO=gpt-5.4
MODEL_FINANCIERO=gpt-5.4-mini
MODEL_RIESGO=gpt-5.4-mini
MODEL_DIAGRAMADOR=gpt-5.4-mini
MODEL_REDACTOR=gpt-5.4-mini
MODEL_GUARD=gpt-5.4-nano
# none | low | medium | high (bajo = más rápido; el enjambre tiene < 120 s)
REASONING_EFFORT=low

# --- Gobierno -------------------------------------------------------------------------
# Prompt Shields (Azure AI Content Safety) con Entra ID. Con un recurso de Foundry (AIServices):
# https://<recurso>.cognitiveservices.azure.com
CONTENT_SAFETY_ENDPOINT=
GUARD_TIMEOUT_S=4
# OpenTelemetry → Application Insights (el conectado al proyecto de Foundry, para verlo en Tracing)
APPLICATIONINSIGHTS_CONNECTION_STRING=
# No exportar prompts/respuestas de visitantes a la telemetría
OTEL_SENSITIVE_DATA=false

# --- Presupuestos del enjambre -----------------------------------------------------
SWARM_TIMEOUT_S=110
DISPLAY_BUDGET_S=120
TURN_IDLE_TIMEOUT_S=25
SWARM_MAX_ROUNDS=9
MAX_DEBATE_ROUNDS=2
# El Financiero objeta si un modelo premium concentra >= este % del costo, o si se pasa del presupuesto
OBJECTION_COMPONENT_SHARE=0.40
OBJECTION_MONTHLY_BUDGET_USD=6000

# --- One-pager, QR y leads -----------------------------------------------------------
# URL pública del backend (Container Apps) que va dentro del QR
PUBLIC_BASE_URL=
# Firma de los links del QR (en Azure: secreto de Container Apps / Key Vault)
LEAD_SECRET=
DATA_DIR=./data
# Vacío = Chromium de Playwright (en el contenedor ya viene instalado)
CHROMIUM_PATH=
# Disparador HTTP del flujo de Power Automate que envía el correo (vacío = queda en outbox)
POWER_AUTOMATE_URL=
MAX_LEADS_PER_SESSION=3
# Aviso de privacidad (validar con el área legal)
PRIVACY_RESPONSABLE=
PRIVACY_CONTACTO=
PRIVACY_AVISO_INTEGRAL=

# --- Mock / replay ------------------------------------------------------------------
MOCK_SPEED=1.0
# Vacío = la sesión curada más reciente en recordings/curated/
REPLAY_FILE=

# --- Frontend (Vite) ---------------------------------------------------------------
# VITE_BRAND_LOGO_URL=/logo-readymind.svg
